# ─────────────────────────────────────────────────────────────
# Copy to `.env` (local) or set in Vercel → Project → Settings → Environment
# Variables (production). NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — use the POOLED connection string (…-pooler.…neon.tech) so the
# serverless WebSocket adapter resumes cleanly after autosuspend.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# next-auth — JWT session signing secret. Generate: `openssl rand -base64 32`
NEXTAUTH_SECRET="<32-byte base64 random>"
# Public base URL of the deployment. On Vercel set this to your production domain
# (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# Superadmin bootstrap (seeded once via `node prisma/seed.ts`). Change in prod.
SUPERADMIN_USERNAME="Mukilan"
SUPERADMIN_PASSWORD="<strong password>"
